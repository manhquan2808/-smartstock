# ======================================================================
# SmartStock - Mẫu biến môi trường.
# Cách dùng: copy file này thành `.env` rồi điền giá trị thật.
#            KHÔNG commit file `.env` lên Git.
# ======================================================================

# ---------- Cơ sở dữ liệu MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smartstock
MYSQL_USER=smartstock
MYSQL_PASSWORD=smartstock123
MYSQL_ROOT_PASSWORD=root123

# Chuỗi kết nối JDBC dùng cho backend (khi chạy trong container đổi localhost -> mysql)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smartstock?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&useSSL=false

# ---------- JWT ----------
# Khóa bí mật HS256: tối thiểu 32 ký tự. Sinh khóa mới:
#   PowerShell: [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
JWT_SECRET=doi-khoa-nay-thanh-chuoi-bi-mat-rieng-cua-ban-toi-thieu-32-ky-tu
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ---------- CORS / Cookie ----------
# Danh sách origin của frontend, phân tách bằng dấu phẩy
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Khi frontend và backend khác domain (Netlify + Render) đặt: none  -> cookie cần Secure=true
APP_COOKIE_SAME_SITE=lax
APP_COOKIE_SECURE=false

# ---------- Email (SMTP) ----------
# DEV: Mailpit trong Docker (không cần user/pass)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@smartstock.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# PRODUCTION (Gmail App Password):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=tai-khoan-cua-ban@gmail.com
#   MAIL_PASSWORD=mat-khau-ung-dung-16-ky-tu
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS=true

# ---------- Đường dẫn công khai ----------
# Dùng để tạo link trong email (đặt lại mật khẩu, phiếu chờ duyệt)
APP_FRONTEND_URL=http://localhost:5173

# ---------- Lưu trữ file ----------
# local = lưu vào thư mục ./uploads ; nếu điền CLOUDINARY_URL hệ thống tự chuyển sang Cloudinary
APP_STORAGE_LOCAL_DIR=uploads
CLOUDINARY_URL=

# ---------- Frontend (Vite) ----------
VITE_API_BASE_URL=http://localhost:8080
